---
import { Picture, Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import BrandMap from '../components/BrandMap.astro';
import { site, faqs, whatsappLink } from '../config/site';

import drBruno from '../assets/dr-bruno.webp';
import consultorio from '../assets/consultorio.png';
import movimento from '../assets/movimento.jpg';
import imgEmagrecer from '../assets/obj-emagrecer.jpg';
import imgMassa from '../assets/obj-massa.jpg';
import imgEsporte from '../assets/obj-esporte.jpg';
import imgDisposicao from '../assets/obj-disposicao.jpg';
import monograma from '../assets/monograma.png';
import logoCompleto from '../assets/logo-completo.png';

const title = 'Dr. Bruno Ricardo | Saúde, emagrecimento e performance em Santo André';
const description =
  'Seu melhor está por vir. Saúde, emagrecimento e performance com acompanhamento médico individualizado em Santo André: consulta de 50 a 60 minutos, avaliação corporal com InBody e leitura de exames.';

const goals = [
  {
    t: 'Emagrecer com saúde',
    d: 'Estratégias para reduzir gordura, preservar massa muscular e construir resultados sustentáveis.',
    img: imgEmagrecer,
    alt: 'Dois corredores em movimento numa avenida',
    pos: '50% 40%',
  },
  {
    t: 'Ganhar massa e força',
    d: 'Orientações alinhadas ao seu corpo, à sua rotina e aos seus exames.',
    img: imgMassa,
    alt: 'Nadador em estilo borboleta numa piscina olímpica',
    pos: '45% 60%',
  },
  {
    t: 'Evoluir no esporte',
    d: 'Avaliação e planejamento para quem está começando, voltando a treinar ou buscando melhorar seu desempenho.',
    img: imgEsporte,
    alt: 'Jogadores de basquete em disputa de bola, em movimento',
    pos: '55% 60%',
  },
  {
    t: 'Ter mais disposição',
    d: 'Um olhar integrado para sono, energia, hábitos e qualidade de vida.',
    img: imgDisposicao,
    alt: 'Homem de cabelos grisalhos correndo ao ar livre',
    pos: '50% 35%',
  },
];

const facts = [
  { t: '50 a 60 minutos', d: 'Tempo para conversar, avaliar e esclarecer suas dúvidas sem pressa.' },
  { t: 'Avaliação corporal', d: 'Análise da composição corporal pelo InBody, incluindo gordura, massa muscular e água corporal.' },
  { t: 'Exames', d: 'Leitura e interpretação dos exames laboratoriais apresentados durante a consulta.' },
  { t: 'Direção', d: 'Orientações individualizadas sobre treino, alimentação, suplementação e estilo de vida, conforme suas necessidades.' },
];

const steps = [
  { t: 'Chame no WhatsApp', d: 'Tire suas dúvidas, consulte valores e reserve o seu horário.' },
  { t: 'Consulta presencial', d: 'Avaliação clínica, composição corporal e leitura dos seus exames. Você sai com um plano claro.' },
  { t: 'Acompanhamento', d: 'Retornos, ajustes e suporte pelo WhatsApp para manter a evolução.' },
];

// cápsulas de foto dentro do título (alternam sozinhas)
const pillA = [imgEmagrecer, imgEsporte, movimento];
const pillB = [imgMassa, imgDisposicao];

// faixa de fotos que desliza com a rolagem
const strip = [imgEsporte, imgDisposicao, imgEmagrecer, imgMassa, movimento, imgEsporte, imgEmagrecer, imgDisposicao];

const agendar = whatsappLink();
const a = site.address;
---

<Base title={title} description={description}>
  <header class="topbar">
    <div class="wrap topbar-in">
      <a href="/" class="brand" aria-label="BrVitta — Vitta Performance, início">
        <Image src={monograma} alt="" width={30} height={32} loading="eager" />
        <span>Vitta Performance</span>
      </a>
      <nav aria-label="Seções">
        <a href="#medico">O médico</a>
        <a href="#objetivos">Objetivos</a>
        <a href="#consulta">A consulta</a>
        <a href="#localizacao">Onde estamos</a>
        <a href="#duvidas">Dúvidas</a>
      </nav>
      <a class="btn btn-gold topbar-cta" href={agendar} data-origem="topo" target="_blank" rel="noopener">
        Agendar<span class="sr-only"> consulta (abre o WhatsApp)</span>
      </a>
    </div>
  </header>

  <main id="conteudo">
    <!-- ───────── Hero: título com cápsulas de foto ───────── -->
    <section class="hero">
      <div class="wrap hero-in">
        <h1 class="hero-title">
          <span class="ht-row">
            <span class="ht-w"><span>Seu</span></span>
            <span class="pill" aria-hidden="true" data-cycle style="--pd: 0.55s">
              {pillA.map((src, i) => (
                <Image src={src} alt="" widths={[420]} sizes="12rem" class:list={{ on: i === 0 }} loading="eager" />
              ))}
            </span>
            <span class="ht-w"><span style="--wd: 0.08s">melhor</span></span>
          </span>
          <span class="ht-row ht-gold">
            <span class="ht-w"><span style="--wd: 0.16s">está por</span></span>
            <span class="pill" aria-hidden="true" data-cycle style="--pd: 0.75s">
              {pillB.map((src, i) => (
                <Image src={src} alt="" widths={[420]} sizes="12rem" class:list={{ on: i === 0 }} loading="eager" />
              ))}
            </span>
            <span class="ht-w"><span style="--wd: 0.24s">vir.</span></span>
          </span>
          <span class="sr-only"> Saúde, emagrecimento e performance em Santo André.</span>
        </h1>

        <p class="hero-sub">Saúde, emagrecimento e performance com acompanhamento médico individualizado.</p>
        <div class="hero-actions">
          <a class="btn btn-gold btn-lg" href={agendar} data-origem="hero" target="_blank" rel="noopener">
            Agendar<span class="sr-only"> consulta (abre o WhatsApp)</span>
          </a>
          <a class="btn btn-ghost btn-lg" href="#medico">Conheça o Dr. Bruno</a>
        </div>
      </div>
    </section>

    <!-- ───────── Faixa de fotos (desliza com a rolagem) ───────── -->
    <div class="strip" data-strip aria-hidden="true">
      <div class="strip-track" data-strip-track>
        {strip.map((src) => (
          <Image src={src} alt="" widths={[360, 640]} sizes="(min-width: 760px) 30vw, 60vw" class="strip-img" />
        ))}
      </div>
    </div>

    <!-- ───────── Dr. Bruno Ricardo ───────── -->
    <section id="medico" class="doctor" aria-labelledby="doctor-name">
      <div class="wrap doctor-grid">
        <figure class="doctor-photo" data-reveal-img>
          <Picture
            src={drBruno}
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={[420, 720]}
            sizes="(min-width: 900px) 36vw, 90vw"
            alt="Dr. Bruno Ricardo, de jaleco e estetoscópio, sorrindo"
          />
        </figure>

        <div class="doctor-body">
          <h2 id="doctor-name" data-split>Dr. Bruno Ricardo</h2>
          <p class="doctor-meta" data-reveal style="--d: 250">
            Médico formado pela Universidade Municipal de São Caetano do Sul<br />
            <span>{site.doctor.crm}</span>
          </p>

          <blockquote class="doctor-story">
            <p class="doctor-lead" data-scrub>
              “Eu já fui gordinho e também já fui muito magro. Cresci inseguro com o meu corpo e, aos 16 anos, comecei a
              treinar e a cuidar da alimentação.
            </p>
            <p data-reveal>
              Com o tempo, percebi que aquela mudança não era apenas física. Entender meu corpo transformou minha
              confiança, minha saúde e a forma como eu vivia.
            </p>
            <p data-reveal>
              Esse interesse me levou à Medicina. Hoje, uso conhecimento médico, experiência prática e acompanhamento
              individualizado para ajudar outras pessoas a construírem mudanças possíveis, saudáveis e duradouras.
            </p>
            <p class="doctor-close" data-reveal>
              Meu maior orgulho não é o corpo que alcancei. É ajudar cada paciente a perceber que, com saúde, estratégia e
              direção, aquilo que hoje parece distante pode se tornar possível.”
            </p>
          </blockquote>
          <div data-reveal>
            <a class="btn btn-navy btn-lg" href={agendar} data-origem="medico" target="_blank" rel="noopener">
              Agendar com o Dr. Bruno<span class="sr-only"> (abre o WhatsApp)</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ───────── Objetivos: lista que troca a foto ───────── -->
    <section id="objetivos" class="goals" data-goals aria-labelledby="goals-title">
      <div class="goals-panel">
        <h2 id="goals-title" data-split>Seus objetivos. Sua realidade. Seu cuidado.</h2>
        <p class="goals-lead" data-reveal style="--d: 250">
          Cuidar da saúde também é construir o corpo e a vida que você deseja.
        </p>
        <p class="goals-text" data-reveal style="--d: 350">
          Na BrVitta, cada acompanhamento começa pela compreensão da sua história, da sua rotina e dos seus objetivos. A
          partir dessa avaliação, definimos prioridades e construímos um plano possível de seguir.
        </p>

        <ul class="goal-list" role="list">
          {
            goals.map((g, i) => (
              <li class:list={['goal', { 'is-active': i === 0 }]} data-reveal style={`--d: ${450 + i * 90}`}>
                <h3>
                  <button type="button" data-goal={i} aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`goal-${i}`}>
                    {g.t}
                  </button>
                </h3>
                <div class="goal-desc" id={`goal-${i}`}>
                  <p>{g.d}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="goals-media" data-reveal-img>
        {
          goals.map((g, i) => (
            <Picture
              src={g.img}
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              widths={[480, 900]}
              sizes="(min-width: 900px) 55vw, 100vw"
              alt={g.alt}
              class:list={['goal-img', { on: i === 0 }]}
              style={`object-position: ${g.pos}`}
              data-goal-img={i}
            />
          ))
        }
      </div>
    </section>

    <!-- ───────── A consulta ───────── -->
    <section id="consulta" class="consult" aria-labelledby="consult-title">
      <div class="wrap consult-grid">
        <figure class="consult-photo" data-reveal-img>
          <Picture
            src={consultorio}
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={[480, 941]}
            sizes="(min-width: 900px) 40vw, 100vw"
            alt="Consultório da BrVitta em Santo André, com mesa de atendimento e balança de bioimpedância InBody"
          />
        </figure>
        <div class="consult-body">
          <h2 id="consult-title" data-split>Uma consulta feita para entender você.</h2>
          <p class="lede" data-reveal style="--d: 250">
            Antes de definir metas, precisamos entender seu corpo, sua saúde e o momento que você está vivendo.
          </p>
          <dl class="facts">
            {
              facts.map((f, i) => (
                <div data-reveal style={`--d: ${350 + i * 110}`}>
                  <dt>{f.t}</dt>
                  <dd>{f.d}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </section>

    <!-- ───────── Do primeiro contato ───────── -->
    <section id="como-funciona" class="steps" aria-labelledby="steps-title">
      <div class="wrap">
        <h2 id="steps-title" data-split>Do primeiro contato ao acompanhamento.</h2>
        <ol class="step-list" role="list" data-reveal>
          {
            steps.map((s, i) => (
              <li style={`--s: ${i}`}>
                <span class="step-n" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h3>{s.t}</h3>
                <p>{s.d}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- ───────── Onde estamos ───────── -->
    <section id="localizacao" class="where" aria-labelledby="where-title">
      <div class="where-panel">
        <h2 id="where-title" data-split>Edifício Works, em Santo André.</h2>
        <address data-reveal style="--d: 250">
          <span>{a.street}{a.unit && ` – ${a.unit}`}</span>
          <span>{a.neighborhood}, {a.city} – {a.state}</span>
          <span>CEP {a.postalCode}</span>
        </address>
        <p class="where-hours" data-reveal style="--d: 350">{site.openingHoursLabel}</p>
        <div class="where-actions" data-reveal style="--d: 450">
          <a class="btn btn-ghost" href={site.mapsUrl} target="_blank" rel="noopener">Abrir no Google Maps</a>
          <a class="btn btn-ghost" href={site.wazeUrl} target="_blank" rel="noopener">Abrir no Waze</a>
        </div>
      </div>
      <div class="where-map">
        <BrandMap />
      </div>
    </section>

    <!-- ───────── Dúvidas ───────── -->
    <section id="duvidas" class="faq" aria-labelledby="faq-title">
      <div class="wrap faq-grid">
        <div class="faq-head">
          <h2 id="faq-title" data-split>O que perguntam antes de marcar.</h2>
          <p class="lede" data-reveal style="--d: 250">Não encontrou a sua dúvida? A equipe responde na hora de agendar.</p>
        </div>
        <div class="faq-list" data-reveal style="--d: 150">
          {
            faqs.map((f) => (
              <details>
                <summary>
                  <h3>{f.q}</h3>
                </summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ───────── Fechamento ───────── -->
    <section id="agendar" class="closing" aria-labelledby="closing-title">
      <Image src={movimento} alt="" widths={[687]} sizes="100vw" class="closing-bg" />
      <div class="wrap closing-in">
        <h2 id="closing-title" data-split>Seu melhor está por vir.</h2>
        <p class="closing-sub" data-reveal style="--d: 300">O primeiro passo é uma conversa.</p>
        <div data-reveal style="--d: 420">
          <a class="btn btn-gold btn-lg" href={agendar} data-origem="final" target="_blank" rel="noopener">
            Agendar<span class="sr-only"> consulta (abre o WhatsApp)</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-foot">
    <div class="wrap foot-in">
      <Image src={logoCompleto} alt="Vitta Performance" width={200} height={67} class="foot-logo" />
      <div class="foot-legal">
        <p>Responsável técnico: {site.doctor.name} · {site.doctor.crm}</p>
        <p>{a.building} · {a.street} · {a.city} – {a.state}</p>
        {site.instagram && <p><a href={site.instagram} class="link" rel="noopener" target="_blank">Instagram</a></p>}
        <p>©{new Date().getFullYear()} Vitta Performance.</p>
      </div>
    </div>
  </footer>

  <script>
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ── Cápsulas do título: alternam as fotos ──
    if (!reduce) {
      document.querySelectorAll<HTMLElement>('[data-cycle]').forEach((pill, n) => {
        const imgs = [...pill.querySelectorAll('img')];
        let i = 0;
        setTimeout(() => {
          setInterval(() => {
            imgs[i].classList.remove('on');
            i = (i + 1) % imgs.length;
            imgs[i].classList.add('on');
          }, 2600);
        }, 1800 + n * 1300);
      });
    }

    // ── Objetivos: item ativo troca a foto; avança sozinho até alguém interagir ──
    const goals = document.querySelector<HTMLElement>('[data-goals]');
    if (goals) {
      const items = [...goals.querySelectorAll<HTMLElement>('.goal')];
      const buttons = [...goals.querySelectorAll<HTMLButtonElement>('[data-goal]')];
      const imgs = [...goals.querySelectorAll<HTMLElement>('[data-goal-img]')];
      let current = 0;
      let timer: number | undefined;
      let userTook = false;
      const set = (i: number) => {
        current = i;
        items.forEach((el, j) => el.classList.toggle('is-active', j === i));
        buttons.forEach((b, j) => b.setAttribute('aria-expanded', String(j === i)));
        imgs.forEach((im, j) => im.classList.toggle('on', j === i));
      };
      const stop = () => { clearInterval(timer); timer = undefined; };
      const start = () => {
        if (reduce || userTook || timer) return;
        timer = window.setInterval(() => set((current + 1) % items.length), 5000);
      };
      buttons.forEach((b, i) => b.addEventListener('click', () => { userTook = true; stop(); set(i); }));
      goals.addEventListener('mouseenter', stop);
      goals.addEventListener('mouseleave', start);
      new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop()), { threshold: 0.4 }).observe(goals);
    }

    // ── Efeitos ligados à rolagem: faixa de fotos e depoimento que "acende" ──
    const strip = document.querySelector<HTMLElement>('[data-strip]');
    const track = document.querySelector<HTMLElement>('[data-strip-track]');
    const scrubs = [...document.querySelectorAll<HTMLElement>('[data-scrub]')].map((el) => {
      const words = el.textContent!.trim().split(/\s+/);
      el.innerHTML = words.map((w) => `<span class="sw">${w}</span>`).join(' ');
      return { el, words: [...el.querySelectorAll<HTMLElement>('.sw')] };
    });

    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    let ticking = false;
    const frame = () => {
      ticking = false;
      const vh = innerHeight;
      if (strip && track && !reduce) {
        const r = strip.getBoundingClientRect();
        if (r.bottom > 0 && r.top < vh) {
          const p = clamp((vh - r.top) / (vh + r.height));
          const max = track.scrollWidth - strip.clientWidth;
          track.style.transform = `translate3d(${(-p * max).toFixed(1)}px,0,0)`;
        }
      }
      for (const { el, words } of scrubs) {
        const r = el.getBoundingClientRect();
        const p = reduce ? 1 : clamp((vh * 0.85 - r.top) / (r.height + vh * 0.35));
        const lit = Math.round(p * words.length);
        words.forEach((w, i) => w.classList.toggle('lit', i < lit));
      }
    };
    const onScroll = () => {
      if (!ticking) { ticking = true; requestAnimationFrame(frame); }
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    frame();
  </script>
</Base>

<style>
  /* ───────── Topo (barra sólida) ───────── */
  .topbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--black);
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }
  .topbar-in {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 4.5rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-right: auto;
    text-decoration: none;
  }
  .brand img {
    width: 26px;
    height: auto;
  }
  .brand span {
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--white);
  }
  nav {
    display: flex;
    gap: 1.75rem;
  }
  nav a {
    position: relative;
    font-size: 0.9375rem;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.35rem;
    height: 1px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.45s var(--ease);
  }
  nav a:hover {
    color: var(--white);
  }
  nav a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .topbar-cta {
    --h: 2.6rem;
    padding: 0 1.5rem;
    font-size: 0.9375rem;
  }

  /* ───────── Hero ───────── */
  .hero {
    position: relative;
    background: radial-gradient(70% 60% at 50% 100%, rgb(35 54 92 / 0.55) 0%, transparent 70%), var(--black);
    overflow: hidden;
  }
  .hero-in {
    /* a faixa de fotos aparece pela metade no fim da primeira tela, convidando a rolar */
    min-height: calc(100svh - 4.5rem - clamp(200px, 22vw, 340px) * 0.5);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding-block: clamp(4rem, 9vh, 7rem) clamp(3rem, 7vh, 5rem);
  }
  .hero-title {
    font-size: clamp(2.6rem, 0.4rem + 7.2vw, 8.4rem);
    font-weight: 800;
    font-stretch: 125%;
    line-height: 0.9;
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }
  .ht-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0 0.22em;
  }
  .ht-row + .ht-row {
    margin-top: 0.04em;
  }
  .ht-gold {
    color: var(--gold);
  }
  .ht-w {
    display: inline-block;
    overflow: hidden;
    padding-block: 0.1em 0.12em;
    margin-block: -0.1em -0.12em;
  }
  .ht-w > span {
    display: inline-block;
    animation: rise 1.3s var(--wd, 0s) var(--ease) both;
  }
  .pill {
    position: relative;
    display: inline-block;
    width: 1.8em;
    height: 0.74em;
    border-radius: 999px;
    overflow: hidden;
    background: var(--navy);
    animation: pill-open 1.4s var(--pd, 0.5s) var(--ease) both;
  }
  .pill :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.15);
    transition:
      opacity 0.9s var(--ease),
      transform 2.6s var(--ease);
  }
  .pill :global(img.on) {
    opacity: 1;
    transform: none;
  }
  .hero-sub {
    margin-top: clamp(1.75rem, 4vh, 2.5rem);
    max-width: 34ch;
    font-size: var(--fs-md);
    line-height: 1.5;
    color: #c9cfdb;
    animation: fade-up 1.2s 0.9s var(--ease) both;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
    animation: fade-up 1.2s 1.05s var(--ease) both;
  }

  @keyframes rise {
    from { transform: translateY(110%); }
    to { transform: none; }
  }
  @keyframes pill-open {
    from { width: 0; opacity: 0; }
    to { width: 1.8em; opacity: 1; }
  }
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: none; }
