---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { whatsappLink } from '../config/site';
---

<Base
  title="Página não encontrada | Vitta Performance"
  description="O endereço que você procurou não existe. Volte para o início ou agende sua consulta com o Dr. Bruno Ricardo."
  path="/404"
  noindex
>
  <SiteHeader />
  <main id="conteudo" class="nf">
    <div class="wrap nf-in">
      <p class="nf-code" aria-hidden="true">404</p>
      <h1>Página não encontrada.</h1>
      <p class="lede">O endereço pode ter mudado ou não existe mais. Volte para o início ou agende sua consulta.</p>
      <div class="nf-actions">
        <a class="btn btn-gold btn-lg" href={whatsappLink()} data-origem="404" target="_blank" rel="noopener">
          Agendar<span class="sr-only"> consulta (abre o WhatsApp)</span>
        </a>
        <a class="btn btn-ghost btn-lg" href="/">Voltar ao início</a>
      </div>
    </div>
  </main>
  <SiteFooter />
</Base>

<style>
  .nf {
    background: radial-gradient(70% 60% at 50% 100%, rgb(35 54 92 / 0.5) 0%, transparent 70%), var(--black);
  }
  .nf-in {
    min-height: calc(100svh - 4.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding-block: 5rem;
  }
  .nf-code {
    font-family: var(--display);
    font-size: clamp(5rem, 3rem + 10vw, 11rem);
    font-weight: 800;
    font-stretch: 125%;
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: var(--gold);
  }
  .nf h1 {
    margin-top: 1.5rem;
    font-size: var(--fs-xl);
  }
  .nf .lede {
    margin-top: 1rem;
  }
  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }
</style>
