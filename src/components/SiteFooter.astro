---
import { Image } from 'astro:assets';
import { site } from '../config/site';
import logoCompleto from '../assets/logo-completo.png';

const a = site.address;
---

<footer class="site-foot">
  <div class="wrap foot-in">
    <Image src={logoCompleto} alt="Vitta Performance" width={200} height={67} densities={[1, 2]} class="foot-logo" />
    <div class="foot-legal">
      <p>Responsável técnico: {site.doctor.name} · {site.doctor.crm}</p>
      <p>{a.building} · {a.street}{a.unit && ` – ${a.unit}`} · {a.city} – {a.state}</p>
      <p>
        <a href="/politica-de-privacidade/" class="link">Política de privacidade</a>
        {site.instagram && <> · <a href={site.instagram} class="link" rel="noopener" target="_blank">Instagram</a></>}
      </p>
      <p>© {new Date().getFullYear()} Vitta Performance.</p>
    </div>
  </div>
</footer>

<style>
  .site-foot {
    padding-block: 3rem;
    background: var(--black);
    border-top: 1px solid rgb(255 255 255 / 0.08);
  }
  .foot-in {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }
  .foot-logo {
    width: 170px;
    height: auto;
  }
  .foot-legal {
    font-size: var(--fs-sm);
    color: var(--muted);
    text-align: right;
    display: grid;
    gap: 0.25rem;
  }
  @media (max-width: 760px) {
    .foot-legal {
      text-align: left;
    }
  }
</style>
